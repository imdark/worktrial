# The Kronos model is derived from that CAD (meshes, masses, pivots, inertias),
# so it stays out of this public repository too. Regenerate it locally -- see
# assets/end_effectors/kronos/README.md.
assets/end_effectors/kronos/*
!assets/end_effectors/kronos/README.md

